{
 "name": "gitlab",
 "path": "/hook/gitlab",
 "auth": {
  "type": "token_header",
  "header": "X-Gitlab-Token",
  "secret": "env:GITLAB_WEBHOOK_TOKEN"
 },
 "map": {
  "event": {
   "template": "{{headers.x-gitlab-event}}.{{payload.object_attributes.status}}{{payload.status}}{{payload.object_attributes.action}}{{payload.action}}",
   "values": {
    "Pipeline Hook.failed": "pipeline.failed",
    "Pipeline Hook.success": "pipeline.succeeded",
    "Merge Request Hook.open": "pull_request.ready",
    "Merge Request Hook.merge": "pull_request.merged",
    "Release Hook.create": "release.published",
    "Deployment Hook.failed": "deploy.failed",
    "Deployment Hook.success": "deploy.succeeded",
    "Merge Request Hook.opened": "pull_request.ready",
    "Release Hook.": "release.published"
   }
  },
  "id": "headers.x-gitlab-event-uuid",
  "repo": {
   "from": "payload.project.path_with_namespace"
  },
  "branch": {
   "template": "{{payload.object_attributes.ref}}{{payload.object_attributes.target_branch}}{{payload.ref}}"
  },
  "author": "payload.user.username",
  "url": {
   "template": "{{payload.object_attributes.url}}{{payload.deployable_url}}{{payload.url}}"
  },
  "title": {
   "template": "{{payload.object_attributes.title}}{{payload.commit_title}}{{payload.name}}"
  },
  "environment": "payload.environment",
  "sha": {
   "template": "{{payload.short_sha}}{{payload.object_attributes.merge_commit_sha}}{{payload.commit.id}}"
  }
 }
}